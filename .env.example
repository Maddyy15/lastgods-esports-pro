# ----------------------------------------------------------------------------
# Copy this file to ".env" and paste your own Supabase values in.
# In Vite, ONLY variables starting with VITE_ are available in the browser.
# These two values are safe for the browser (the anon key is protected by RLS).
# NEVER put the Supabase "service_role" key in this file or anywhere in /src.
# ----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
